{
  "name": "turbo-mono-repo",
  "private": true,
  "homepage": "https://github.com/srinivas-jay/turbo-mono-repo#readme",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "prepare": "husky",
    "release": "lerna publish from-git --yes --no-verify-access",
    "test": "turbo run test",
    "version-packages": "lerna version --conventional-commits --yes --push"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/node": "^25.5.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@turbo/gen": "^2.9.2",
    "commitizen": "^4.3.1",
    "commitlint-plugin-workspace-scopes": "^1.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^17.3.1",
    "husky": "^9.1.7",
    "lerna": "^9.0.7",
    "markdownlint-cli": "^0.48.0",
    "rimraf": "^6.1.3",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "turbo": "latest",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "engineStrict": true
}
