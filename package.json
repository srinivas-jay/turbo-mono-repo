{
  "name": "turbo-mono-repo",
  "private": true,
  "homepage": "https://github.com/srinivas-jay/turbo-mono-repo#readme",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "prepare": "husky",
    "release": "lerna publish from-git --yes --no-verify-access",
    "test": "turbo run test",
    "version-packages": "lerna version --conventional-commits --yes --push"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^25.9.3",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@turbo/gen": "^2.9.18",
    "commitizen": "^4.3.2",
    "commitlint-plugin-workspace-scopes": "^1.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "lerna": "^9.0.7",
    "markdownlint-cli": "^0.48.0",
    "rimraf": "^6.1.3",
    "tslib": "^2.8.1",
    "tsx": "^4.22.4",
    "turbo": "latest",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "engineStrict": true
}